# ─── 应用配置 ────────────────────────────────────────────────────────────────
APP_PORT=8888
# offline = HTTP，online = HTTPS
SERVER_ENV=offline
# 线上证书在宿主机的路径，会挂进容器的 /home/guan/service.pem 和 service.key
SSL_CERT_HOST=/home/guan/service.pem
SSL_KEY_HOST=/home/guan/service.key
DEBUG=false
# 小程序审核开关。1 时关闭手机号绑定验证（审核期可不开短信），其余与正常一致
UNDER_REVIEW=0
# 首页未约上场次最远可见距离（公里），默认 100
LIST_MAX_DISTANCE_KM=100
# 生产环境请替换为随机强密钥
COOKIE_SECRET=change_me_in_production

# ─── MySQL ───────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=guan
MYSQL_USER=guan
MYSQL_PASSWORD=guan123
# 暴露到宿主机的端口
MYSQL_EXPOSE_PORT=3306

# 默认只绑本机；需要对外开放时才改成 0.0.0.0，并且必须先换掉上面的默认口令
MYSQL_BIND_ADDR=127.0.0.1

# ─── Redis ───────────────────────────────────────────────────────────────────
# Redis 里存着运行时身份密钥。线上应设置密码
REDIS_PASSWORD=
REDIS_EXPOSE_PORT=6379
REDIS_BIND_ADDR=127.0.0.1

# ─── 微信小程序 ───────────────────────────────────────────────────────────────
WX_APPID=your_wx_appid
WX_SECRET=your_wx_secret
WX_TOKEN=your_wx_token
WX_ENCODING_AES_KEY=your_encoding_aes_key
WX_SUBSCRIBE_NOTI_TID=your_subscribe_template_id

# ─── 火山引擎 ────────────────────────────────────────────────────────────────
# 火山方舟资料提取。密钥在方舟控制台 API Key 管理。模型换成已开通的 Model ID。
VOLC_ARK_API_KEY=
VOLC_ARK_API_BASE=https://ark.cn-beijing.volces.com/api/v3
VOLC_ARK_MODEL=doubao-seed-2-1-lite-260915

# ─── 七牛 CDN ─────────────────────────────────────────────────────────────────
QINIU_ACCESS_KEY=your_qiniu_access_key
QINIU_SECRET_KEY=your_qiniu_secret_key
QINIU_BUCKET=your_bucket_name

# ─── 阿里云短信 ───────────────────────────────────────────────────────────────
# AccessKey 用只含短信发送权限的 RAM 用户。签名和模板都要在短信控制台审核通过。
# 验证码模板只有一个变量 code。正文示例：验证码${code}，5分钟内有效
# 这里的 5 分钟要和验证码有效时间一致。
# 通知模板变量是 title、when、note。正文示例：关关雎鸠：${title}。${when}。${note}
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_VERIFY_TEMPLATE_CODE=
ALIYUN_SMS_NOTICE_TEMPLATE_CODE=

# ─── 高德 Web 服务 ───────────────────────────────────────────────────────────
# 门店导入脚本用。控制台创建 Key 时类型选「Web服务」。
# https://console.amap.com/dev/key/app
AMAP_WEB_KEY=
