# ─── 应用配置 ────────────────────────────────────────────────────────────────
APP_PORT=8888
# offline = HTTP，online = HTTPS（需挂载 SSL 证书）
SERVER_ENV=offline
DEBUG=false
# 生产环境请替换为随机强密钥
COOKIE_SECRET=change_me_in_production

# ─── MySQL ───────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=guan
MYSQL_USER=guan
MYSQL_PASSWORD=guan123
# 暴露到宿主机的端口
MYSQL_EXPOSE_PORT=3306

# 默认只绑本机；需要对外开放时才改成 0.0.0.0，并且必须先换掉上面的默认口令
MYSQL_BIND_ADDR=127.0.0.1

# ─── Redis ───────────────────────────────────────────────────────────────────
# Redis 里存着运行时身份密钥。线上必须设置密码，SERVER_ENV=online 时密码为空会拒绝启动
REDIS_PASSWORD=
REDIS_EXPOSE_PORT=6379
REDIS_BIND_ADDR=127.0.0.1

# ─── 微信小程序 ───────────────────────────────────────────────────────────────
WX_APPID=your_wx_appid
WX_SECRET=your_wx_secret
WX_TOKEN=your_wx_token
WX_ENCODING_AES_KEY=your_encoding_aes_key
WX_SUBSCRIBE_NOTI_TID=your_subscribe_template_id

# ─── 火山引擎 ────────────────────────────────────────────────────────────────
# 火山方舟资料提取。密钥在方舟控制台 API Key 管理。模型换成已开通的 Model ID。
VOLC_ARK_API_KEY=
VOLC_ARK_API_BASE=https://ark.cn-beijing.volces.com/api/v3
VOLC_ARK_MODEL=doubao-seed-2-1-lite-260915

# ─── 七牛 CDN ─────────────────────────────────────────────────────────────────
QINIU_ACCESS_KEY=your_qiniu_access_key
QINIU_SECRET_KEY=your_qiniu_secret_key
QINIU_BUCKET=your_bucket_name
