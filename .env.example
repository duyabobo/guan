# ─── 应用配置 ────────────────────────────────────────────────────────────────
APP_PORT=8888
# offline = HTTP，online = HTTPS（需挂载 SSL 证书）
SERVER_ENV=offline
DEBUG=false
# 生产环境请替换为随机强密钥
COOKIE_SECRET=change_me_in_production

# ─── MySQL ───────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=guan
MYSQL_USER=guan
MYSQL_PASSWORD=guan123
# 暴露到宿主机的端口（不对外暴露可设置为 127.0.0.1:3306）
MYSQL_EXPOSE_PORT=3306

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_EXPOSE_PORT=6379

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_USER=guan
RABBITMQ_PASSWORD=guan123
RABBITMQ_EXPOSE_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ─── 微信小程序 ───────────────────────────────────────────────────────────────
WX_APPID=your_wx_appid
WX_SECRET=your_wx_secret
WX_TOKEN=your_wx_token
WX_ENCODING_AES_KEY=your_encoding_aes_key
WX_SUBSCRIBE_NOTI_TID=your_subscribe_template_id

# ─── OpenAI / LLM（自然语言信息提取）────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ─── 七牛 CDN ─────────────────────────────────────────────────────────────────
QINIU_ACCESS_KEY=your_qiniu_access_key
QINIU_SECRET_KEY=your_qiniu_secret_key
QINIU_BUCKET=your_bucket_name
